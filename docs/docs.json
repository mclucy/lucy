{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "lucy",
  "colors": {
    "primary": "#FF3E99",
    "light": "#FF75C7",
    "dark": "#E8166C"
  },
  "favicon": "https://minecraft.wiki/images/Bucket_of_Axolotl_JE1_BE1.png?a9d5c&format=original",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": ["index", "quickstart"]
