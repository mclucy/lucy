{
  "$schema": "https://mintlify.com/docs.json",
  "colors": {
    "dark": "#E8166C",
    "light": "#FF75C7",
    "primary": "#FF3E99"
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "favicon": "https://minecraft.wiki/images/Bucket_of_Axolotl_JE1_BE1.png?a9d5c&format=original",
  "footer": {
    "socials": {
      "github": "https://github.com/mclucy/lucy"
    }
  },
  "logo": {
    "dark": "https://minecraft.wiki/images/Bucket_of_Axolotl_JE1_BE1.png?a9d5c&format=original",
    "light": "https://minecraft.wiki/images/Bucket_of_Axolotl_JE1_BE1.png?a9d5c&format=original"
  },
  "name": "lucy",
  "navbar": {},
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Repository",
          "href": "https://github.com/mclucy/lucy",
          "icon": "github"
        }
      ]
    },
    "pages": [
      {
        "group": "Getting Started",
        "pages": ["index", "quickstart", "agents"]
      },
      {
        "group": "Commands",
        "pages": [
          "commands/global-flags",
          "commands/create",
          "commands/init",
          "commands/install",
          "commands/java",
          "commands/config",
          "commands/telemetry",
          "commands/add",
          "commands/remove",
          "commands/deinit",
          "commands/file",
          "commands/search",
          "commands/compile",
          "commands/info",
          "commands/status",
          "commands/store"
        ]
      },
      {
        "group": "File tracking",
        "pages": ["file-tracking/overview", "file-tracking/tracking", "file-tracking/recovery"]
      }
    ]
  },
  "theme": "luma"
}
