  "logo": {
    "light": "https://minecraft.wiki/images/Bucket_of_Axolotl_JE1_BE1.png?a9d5c&format=original",
    "dark": "https://minecraft.wiki/images/Bucket_of_Axolotl_JE1_BE1.png?a9d5c&format=original"
  },
  "navbar": {},
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/mclucy/lucy"
    }
  }
