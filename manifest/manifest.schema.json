{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mclucy/lucy/main/manifest/manifest.schema.json",
  "properties": {
    "manifest_version": {
      "type": "integer"
    },
    "server": {
      "properties": {
        "minecraft": {
          "type": "string"
        },
        "directory": {
          "type": "string"
        },
        "core": {
          "properties": {
            "product": {
              "type": "string"
            },
            "product_version": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "file_pattern": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "type": "object",
          "required": [
            "product",
            "product_version"
          ]
        },
        "packages": {
          "additionalProperties": {
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string",
                  "description": "A version selector: any, stable, beta, a tag, or an exact version."
                },
                {
                  "properties": {
                    "selector": {
                      "type": "string",
                      "description": "A version selector: any, stable, beta, a tag, or an exact version."
                    },
                    "file_pattern": {
                      "type": "string",
                      "description": "Glob pattern matching the upstream artifact filename."
                    },
                    "enabled": {
                      "type": "boolean",
                      "description": "Whether the requirement is active in the resolved environment.",
                      "default": true
                    }
                  },
                  "additionalProperties": false,
                  "type": "object"
                }
              ]
            },
            "type": "object"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "minecraft",
        "directory",
        "core",
        "packages"
      ]
    },
    "mcdr": {
      "properties": {
        "directory": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "packages": {
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "description": "A version selector: any, stable, beta, a tag, or an exact version."
              },
              {
                "properties": {
                  "selector": {
                    "type": "string",
                    "description": "A version selector: any, stable, beta, a tag, or an exact version."
                  },
                  "file_pattern": {
                    "type": "string",
                    "description": "Glob pattern matching the upstream artifact filename."
                  },
                  "enabled": {
                    "type": "boolean",
                    "description": "Whether the requirement is active in the resolved environment.",
                    "default": true
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            ]
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "directory",
        "version",
        "packages"
      ]
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "manifest_version",
    "server"
  ],
  "title": "Lucy manifest",
  "description": "Desired-state manifest (lucy.yaml) for a Lucy-managed Minecraft server."
}
